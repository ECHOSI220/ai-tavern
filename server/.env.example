# Public project configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Server-only secret. Configure with `wrangler secret put`; never put it in APK.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

SERVER_ENV=development
SERVER_VERSION=1.0.0
PROTOCOL_VERSION=3
MAX_MESSAGE_BYTES=65536
RECONNECT_GRACE_SECONDS=180
